# Copie para .env.local e preencha (o .env.local não vai pro Git).
#
# Supabase -> Settings -> Data API  ....... Project URL
# Supabase -> Settings -> API Keys  ....... Publishable key
#
# Use SÓ o domínio na URL, sem /rest/v1 no final.
# Depois de mexer aqui, reinicie o `npm run dev`:
# o Vite só lê o .env na inicialização.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
