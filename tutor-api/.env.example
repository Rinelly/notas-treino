# Copie para .env e preencha (o .env não vai pro Git).

# Provedor de IA: gemini (gratuito) ou claude (precisa de créditos)
LLM_PROVIDER=gemini

# Gemini — crie a chave em https://aistudio.google.com/apikey
# (cole logo depois do "=", sem espaço)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Quanto o modelo raciocina antes de responder: minimal (mais rápido,
# padrão), low, medium, high — ou default para o padrão do modelo.
GEMINI_THINKING=minimal

# Claude — só se trocar LLM_PROVIDER para claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ---------------------------------------------------------------
# Só para quando a API estiver publicada na internet.
# No seu computador pode deixar tudo abaixo em branco.
# ---------------------------------------------------------------

# De onde o app pode chamar a API (separe por vírgula)
CORS_ORIGINS=http://localhost:5173

# Preenchidos, a API só responde a quem está logado no app.
# São os mesmos valores do .env.local do app.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Opcional: só estes e-mails podem usar o tutor (separe por vírgula)
ALLOWED_EMAILS=
